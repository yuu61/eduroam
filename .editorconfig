# エディタ共通の書式。shfmt はシェルスクリプトの書式をここから読む
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 4
# shfmt: case の中身をインデントし、冗長な書き方を簡略化する（shfmt -s）
switch_case_indent = true
simplify = true

# FreeRADIUS / eapol_test の設定ファイル
[*.j2]
indent_size = 4

[ansible/roles/freeradius/files/**]
indent_size = 4

[Makefile]
indent_style = tab

# ドキュメントはリンター対象外。末尾の空白 2 つは改行として使われる
[*.md]
trim_trailing_whitespace = false
