---
# yamllint 設定（ansible-lint の yaml ルールもこの設定を使う）
# 方針: 全ルールを有効にし、すべてエラーとして扱う
extends: default

ignore-from-file: .gitignore

rules:
  anchors:
    forbid-undeclared-aliases: true
    forbid-duplicated-anchors: true
    forbid-unused-anchors: true
  braces:
    max-spaces-inside: 1
  comments:
    level: error
    min-spaces-from-content: 1
  # 無効化: ansible-lint が false を要求する（有効にすると yaml ルールと --fix が使えなくなる）
  comments-indentation: disable
  document-end:
    present: true
  document-start:
    level: error
  empty-values: enable
  float-values:
    require-numeral-before-decimal: true
    forbid-scientific-notation: true
    forbid-nan: true
    forbid-inf: true
  # 無効化: キーのアルファベット順は ansible-lint の key-order（タスクは name を先頭）と両立しない
  key-ordering: disable
  line-length:
    max: 160
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  quoted-strings:
    quote-type: double
    required: only-when-needed
    allow-quoted-quotes: true
  truthy:
    level: error
    allowed-values: ["true", "false"]
...
