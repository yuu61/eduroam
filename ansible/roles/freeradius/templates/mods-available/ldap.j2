# {{ ansible_managed }}
# 検証用 OpenLDAP モジュール (Phase 1)
ldap {
    server = "{{ freeradius_ldap_server }}"
    port = {{ freeradius_ldap_port }}
    identity = "{{ freeradius_ldap_identity }}"
    password = $ENV{LDAP_BIND_PASSWORD}
    base_dn = "{{ freeradius_ldap_base_dn }}"

    sasl {
    }

    update {
{% if freeradius_ldap_auth_method == 'attribute' %}
        # userPassword を取得し、PAP モジュールで照合する
        control:Password-With-Header += 'userPassword'
{% else %}
        # bind 認証のためパスワード属性は取得しない
{% endif %}
    }

    user {
        base_dn = "ou=people,${..base_dn}"
        filter = "{{ freeradius_ldap_user_filter }}"
    }

    group {
        base_dn = "ou=groups,${..base_dn}"
        filter = "(objectClass=posixGroup)"
        membership_attribute = "memberUid"
    }

    options {
        chase_referrals = yes
        rebind = yes
        res_timeout = 10
        srv_timelimit = 3
        net_timeout = 1
        idle = 60
        probes = 3
        interval = 3
        ldap_debug = 0x0028
    }

    pool {
        start = 5
        min = 3
        max = 32
        spare = 10
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }
}
