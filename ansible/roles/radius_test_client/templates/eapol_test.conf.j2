# {{ ansible_managed }}
# EAP-TTLS/PAP テスト設定
# eapol_test -c {{ test_client_conf_dir }}/{{ item.dest }} -s <secret> -a <server IP>
network={
    ssid="eduroam"
    key_mgmt=WPA-EAP
    eap=TTLS
    anonymous_identity="{{ test_client_anonymous_identity }}"
    identity="{{ item.identity }}"
    password="{{ item.password }}"
    phase2="auth=PAP"
{% if test_client_ca_src | length > 0 %}
    # サーバ証明書を CA と接続先ドメインで検証する
    ca_cert="{{ test_client_conf_dir }}/ca.crt"
{% if test_client_server_domain | length > 0 %}
    domain_suffix_match="{{ test_client_server_domain }}"
{% endif %}
{% endif %}
}
